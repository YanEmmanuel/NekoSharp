/debug+
/debug:portable
/filealign:512
/optimize-
/out:obj/Debug/net10.0/NekoSharp.App.dll
/refout:obj/Debug/net10.0/refint/NekoSharp.App.dll
/target:exe
/warnaserror-
/utf8output
/deterministic+
/langversion:14.0
/warnaserror+:NU1605,SYSLIB0011

